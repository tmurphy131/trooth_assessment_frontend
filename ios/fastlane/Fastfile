default_platform(:ios)

platform :ios do
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"]
    )
    match(type: "appstore", readonly: true, api_key: api_key)
    repo_root = File.expand_path("../..", __dir__)
    sh("cd #{repo_root} && flutter build ipa --release " \
       "--export-options-plist=ios/ExportOptions.plist " \
       "--dart-define=API_BASE_URL=#{ENV['API_BASE_URL']}")
    # Crashlytics needs the dSYMs to symbolicate native iOS crashes. The SPM
    # build checks out firebase-ios-sdk, which ships the upload tool. A failed
    # upload shouldn't block the release.
    begin
      upload_symbols_to_crashlytics(
        dsym_paths: Dir[File.join(repo_root, "build/ios/archive/Runner.xcarchive/dSYMs/*.dSYM")],
        gsp_path: File.join(repo_root, "ios/Runner/GoogleService-Info.plist"),
        binary_path: File.join(repo_root, "build/ios/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")
      )
    rescue => e
      UI.important("Crashlytics dSYM upload failed: #{e.message}")
    end
    upload_to_testflight(
      api_key: api_key,
      ipa: Dir[File.join(repo_root, "build/ios/ipa/*.ipa")].first,
      skip_waiting_for_build_processing: true
    )
  end
end
